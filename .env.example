# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian
DATABASE_URL=postgres://meridian:change-me@localhost:5432/meridian

# API
API_PORT=3000
SESSION_SECRET=change-me-64-random-chars

# Encryption key for SimpleFIN access URLs (32 bytes, base64). Generate with:
#   openssl rand -base64 32
SECRETS_KEY=

# Worker
SYNC_INTERVAL_HOURS=6

# Caddy: hostname the server answers to on the LAN (or Tailscale MagicDNS name)
SITE_ADDRESS=meridian.local

# Backups: passphrase for encrypting nightly pg_dump output
BACKUP_PASSPHRASE=
