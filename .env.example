# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian
# Local development (docker compose publishes db on 127.0.0.1:5432). Inside Docker the
# containers ignore this and build the URL from the POSTGRES_* values above.
DATABASE_URL=postgres://meridian:change-me@localhost:5432/meridian
# Integration tests create throwaway databases on this server (role needs CREATEDB).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian_test
# Their names start with this prefix (default meridian_test_); set one per checkout when several share a server.
# TEST_DATABASE_PREFIX=meridian_test_

# API
API_PORT=3000
# Interface the API listens on. Loopback by default; the Docker image and compose file set
# 0.0.0.0 inside the container (its port is never published). Leave unset unless you run the
# API outside Docker behind a proxy on another machine.
# API_HOST=127.0.0.1
# The reverse proxy's address(es), comma separated: IPs, CIDR ranges, or the presets loopback,
# linklocal, uniquelocal. Only these peers may state the client address and public host
# (X-Forwarded-For / X-Forwarded-Host); the sign-in rate limits count that address. Empty trusts
# nobody, which is right when browsers reach the API directly (pnpm dev). The compose file sets
# `uniquelocal` for the web container. "true" and hop counts are refused.
# TRUST_PROXY=
# Signs the session cookie. At least 32 random characters:  openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-chars
# A signed-in session ends after SESSION_TTL_DAYS however often it is used, or after
# SESSION_IDLE_DAYS without a request, whichever comes first. (A password-only session,
# before the authenticator code, always ends after ten minutes.)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14

# Encryption key for SimpleFIN access URLs, setup tokens and TOTP secrets (32 bytes, base64):
#   openssl rand -base64 32
# Keep it out of the database and the backups. With Docker secrets, leave this empty and
# set SECRETS_KEY_FILE to the mounted secret path instead.
SECRETS_KEY=
SECRETS_KEY_FILE=

# Worker
# A connection is synced every SYNC_INTERVAL_HOURS, counted from its last attempt whether it
# worked or not. One the Bridge refuses outright (403 access revoked, 402 payment required)
# is not scheduled again until a sync started from the Connections page succeeds.
SYNC_INTERVAL_HOURS=6
WORKER_POLL_MS=5000
# The first sync and a "Full resync" ask the Bridge for this many days, and no sync ever asks
# for more. Later syncs start SIMPLEFIN_OVERLAP_DAYS before the last complete sync, which does
# not move while a bank needs re-authentication or the Bridge could not read an account.
SIMPLEFIN_INITIAL_WINDOW_DAYS=93
SIMPLEFIN_OVERLAP_DAYS=7

# Price feed (worker; the API reads PRICE_PROVIDER only to show the feed's state).
# "none" (the default) never fetches: valuations use implied and manual prices and the Prices
# page says so. "tiingo" fetches end-of-day closes and fund NAVs from Tiingo, which needs a free
# API key from https://www.tiingo.com — confirm the free plan's current terms, limits and fund
# coverage at signup (at the time of writing: personal use, ~500 symbols/month, 50 requests/hour,
# 1,000/day; the worker makes at most 45 requests per run, spaced 1.5 s apart). The key is read
# from the environment or from the Docker secret file named by TIINGO_API_KEY_FILE and never
# enters the database or the backups.
PRICE_PROVIDER=none
TIINGO_API_KEY=
TIINGO_API_KEY_FILE=
# Household-local hours of the nightly fetch (after the US close) and the conditional morning
# catch-up ("off" disables it).
PRICE_FETCH_HOUR=18
PRICE_CATCHUP_HOUR=6

# Caddy: hostname the server answers to on the LAN (or Tailscale MagicDNS name)
SITE_ADDRESS=meridian.local

# Backups: passphrase for encrypting nightly pg_dump output, hour (UTC) to run, optional off-site copy command
BACKUP_PASSPHRASE=
BACKUP_HOUR=2
# BACKUP_COPY_CMD=rclone copy "$1" remote:meridian-backups
