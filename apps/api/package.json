{
  "name": "@meridian/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../scripts/bundle.mjs src/server.ts dist/server.js && node ../../scripts/bundle.mjs src/admin.ts dist/admin.js",
    "admin": "tsx src/admin.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.11",
    "@meridian/db": "workspace:*",
    "@meridian/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "otpauth": "^9.3.6",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "re2js": "2.8.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2"
  }
}
